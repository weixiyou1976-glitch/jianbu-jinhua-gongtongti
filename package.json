{
  "name": "jianbu-jinhua-gongtongti",
  "version": "1.0.0",
  "private": true,
  "description": "渐步进化共同体 —— 一周一枚策印，持续52周的进化路径",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "node backend/seed.js",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "build:frontend": "npm --prefix frontend run build",
    "validate:skills": "node backend/scripts/validate-skills.cjs",
    "compare:skills": "node backend/scripts/compare-skills.cjs",
    "export:skills": "node backend/scripts/export-skills-readonly.cjs",
    "rehearse:skills": "node backend/scripts/rehearse-skills.cjs",
    "test:skills-source": "node --test backend/tests/skill-source.test.cjs",
    "restore:skills": "node backend/scripts/restore-skills.cjs"
  }
}
